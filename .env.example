# Local
VITE_API_BASE_URL=http://localhost:3002/api/v3
# Socket.IO base (sin /api/v3). Usado por PRP 009 (/orders, /events).
VITE_SOCKET_BASE_URL=http://localhost:3002

# Railway / remoto
# VITE_API_BASE_URL=https://ssgg-production.up.railway.app/api/v3
# VITE_SOCKET_BASE_URL=https://ssgg-production.up.railway.app

VITE_ENVIRONMENT=development

# Target del proxy Vite si usas VITE_API_BASE_URL=/api/v3 (también proxy /socket.io)
VITE_DEV_BACKEND_URL=http://127.0.0.1:3002

# true = demo offline (apiMock). false = login JWT + sockets reales.
VITE_USE_API_MOCK=true
